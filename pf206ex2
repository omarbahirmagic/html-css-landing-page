<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PF206EX2</title>
    <style>
        body{
            background-color:gray;
        }

        .ppcard{
            width:700px;
            height:350px;
            background-color:cyan;
            position:relative;
            margin-left:400px;
            margin-top:250px;
            padding:2px;
            
        }
        .inside img{
            position:absolute;
            left:5px;
            top:5px;
            width:200px;
            height:150px;
        }
        .info{
            position:absolute;
            left:240px;
            top:5px;
        }
        .circle{
            position:absolute;
            right:5px;
            top:5px;
            border-radius:50%;
            background-color:red;
            width:50px;
            height:50px;
        }
        .square{
            position:absolute;
            left:5px;
            bottom:5px;
            border:1px solid black;
            background-color:orange;
            width:50px;
            height:50px;
        }
        button{
            position:fixed;
            right:8px;
            bottom:5px;
            border:1px solid black;
            border-radius:15px;
            background-color:green;
            color:white;
            width:50px;
            height:35px;
            
        }
        button:hover{
            background-color:limegreen;
            color:black;
        }
        }

    </style>
</head>
<body>
    <div class="ppcard">
        <div class="inside">
            <img src="https://thumbs.dreamstime.com/b/businessman-avatar-cartoon-character-profile-
            picture-wearing-suit-glasses-portrait-round-icon-vector-illustration-graphic-149144704.jpg" alt="avataricon"/>
            <div class="info">
            <p><strong>Name:</strong>Omar</p>
            <p><strong>Surname:</strong>Gurbanov</p>
            <p><strong>Age:</strong>18</p>
            <p>Mən Front-End Developer olmaq yolunda çalışıram.Html CSS bilirəm.</p>
            </div>
        </div>
        <div class="circle"></div>
        <div class="square"></div>
        <button>Button</button>
    </div>
    
</body>
</html>
